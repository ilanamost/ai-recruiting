# Staging environment.
# Set these as environment variables on whatever host runs the staging backend
# (they are not read from a committed file). Placeholder values only here: never commit a real secret.

# Postgres connection string for the staging database — managed hosts usually require SSL.
DATABASE_URL=postgres://recruiting:changeme@staging-db.example.com:5432/recruiting?sslmode=require

# Random secret used to sign JWT access tokens — generate a distinct one per environment.
JWT_SECRET=changeme-generate-a-real-secret

# Port the Express server listens on — defaults to 3001 if unset (src/index.ts). Most hosts inject their own PORT.
PORT=3001

# Origin of the deployed staging frontend, scheme + host only (no trailing path or slash).
# Must match exactly or CORS and the cross-site auth cookies break (src/app.ts's cors()).
FRONTEND_URL=https://staging.example.com

# development | staging | production — anything other than 'development' (unset counts as development)
# sends auth cookies as sameSite=none/secure=true.
NODE_ENV=staging

# Claude model used to score resumes against jobs — defaults to 'claude-sonnet-5' if unset (src/scoring/index.ts).
SCORING_MODEL=claude-sonnet-5

# Anthropic API key — read implicitly by the SDK's `new Anthropic()` in src/scoring/index.ts.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Local development environment.
# Copy to `backend/.env` and fill in real values — `.env` is gitignored, this file is not.
# Placeholder values only in this file: never commit a real secret.

# Postgres connection string the API connects to (src/index.ts -> createPgStore).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recruiting

# Random secret used to sign JWT access tokens — generate your own, do not ship this value.
JWT_SECRET=changeme-generate-a-real-secret

# Port the Express server listens on — defaults to 3001 if unset (src/index.ts).
PORT=3001

# Origin of the frontend, scheme + host + port only (no trailing path or slash).
# Must match the deployed frontend's origin exactly or CORS and auth cookies break (src/app.ts's cors()).
FRONTEND_URL=http://localhost:5173

# development | staging | production — 'development' (or unset) keeps auth cookies on sameSite=lax/secure=false.
NODE_ENV=development

# Claude model used to score resumes against jobs — defaults to 'claude-sonnet-5' if unset (src/scoring/index.ts).
SCORING_MODEL=claude-sonnet-5

# Claude model used to read years-of-experience and skills off an uploaded CV —
# defaults to 'claude-sonnet-5' if unset (src/analysis/index.ts).
ANALYSIS_MODEL=claude-sonnet-5

# Anthropic API key — read implicitly by the SDK's `new Anthropic()` in
# src/scoring/index.ts and src/analysis/index.ts. Unset is survivable: uploads
# still succeed, the CV is simply stored unclassified.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
